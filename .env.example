# PostgreSQL connection string
DATABASE_URL=postgres://tnc:tnc@localhost:5432/tnc?sslmode=disable

# HTTP (web form) listen address
HTTP_ADDR=:8080

# TCP (device) listen address
TCP_ADDR=:9000

# Secret used to sign/secure session cookies (change in production)
SESSION_SECRET=change-me-please-32-bytes-minimum

# Bootstrap privileged user, created on first start if it does not exist
BOOTSTRAP_ADMIN_USER=admin
BOOTSTRAP_ADMIN_PASSWORD=admin
